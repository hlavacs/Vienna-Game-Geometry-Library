#version 450

struct AABB {
    vec3 min;
    vec3 max;
};

struct AABB_pair {
    AABB box1;
    AABB box2;
};

AABB addVector(const AABB box, const vec3 v) {
    AABB aabbOut;
    aabbOut.min = box.min + v;
    aabbOut.max = box.max + v;
    return aabbOut;
}

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(std430, binding = 0) readonly buffer inBuffer{
    AABB_pair pairs_in[];
};

layout(std430, binding = 1) buffer outBuffer{
    AABB_pair pairs_out[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= pc.N) return;

    const AABB_pair pair = pairs_in[index];

    const AABB aabbOut1 = addVector(pair.box1, vec3(1.5));
    const AABB aabbOut2 = addVector(pair.box2, vec3(3.5));

    pairs_out[index] = AABB_pair(aabbOut1, aabbOut2);

}