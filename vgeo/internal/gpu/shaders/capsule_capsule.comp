#version 450

struct Capsule {
    vec3 a;
    vec3 b;
    float radius;
};

struct Contact{
    bool hasContact;
    float depth;
    vec3 normal;
    vec3 witnessA;
    vec3 witnessB;
};

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(std430, binding = 0) readonly buffer inBuffer{
    Capsule capsule_in[];
};

layout(std430, binding = 1) buffer outBuffer{
    Contact contacts[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= pc.N) return;

    const Capsule capsuleA = capsule_in[2*index];
    const Capsule capsuleB = capsule_in[2*index+1];



    contacts[index] = Contact(true, capsuleB.radius, capsuleA.a, capsuleA.b, capsuleB.a);

}