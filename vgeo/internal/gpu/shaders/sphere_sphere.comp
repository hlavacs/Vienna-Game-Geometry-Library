#version 450

#extension GL_ARB_shading_language_include : enable

#include "shader_terathon.h"
#include "vgeo.h"

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer sphereBuffer{
    Sphere3D spheres_in[];
};

layout(std430, set = 1, binding = 0) readonly buffer inBuffer{
    CollisionPairData pairData_in[];
};

layout(std430, set = 1, binding = 1) writeonly buffer outBuffer{
    Contact contacts[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= pc.N) return;

    const uint indexA = pairData_in[index].indexA;
    const uint indexB = pairData_in[index].indexB;

    const vec2 idA = pairData_in[index].instanceHandleA;
    const vec2 idB = pairData_in[index].instanceHandleB;

    const Motor3D motorA = pairData_in[index].motorA;
    const Motor3D motorB = pairData_in[index].motorB;

    Sphere3D sphereA = spheres_in[indexA];
    Sphere3D sphereB = spheres_in[indexB];

    sphereA = applyTransform(sphereA, motorA, 1.0);
    sphereB = applyTransform(sphereB, motorB, 1.0);

    const Sphere3D s1 = unitize(sphereA);
    const Sphere3D s2 = unitize(sphereB);

    const Circle3D intersectionCircle = antiwedge(s1, s2);

    if (squaredRadiusNorm(intersectionCircle) < 0.0) {
        contacts[index] = Contact(false, 0.0, idA, idB, vec3(0.0, 0.0, 0.0),vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const FlatPoint3D fp1 = flatCenter(s1);
    const FlatPoint3D fp2 = flatCenter(s2);
    const Point3D center1 = Point3D(fp1.x, fp1.y, fp1.z);
    const Point3D center2 = Point3D(fp2.x, fp2.y, fp2.z);
    const float radius1 = sqrt(squaredRadiusNorm(s1));
    const float radius2 = sqrt(squaredRadiusNorm(s2));

    const Vector3D delta = subtract(center1, center2);
    float dist  = magnitude(delta);
    float depth = (radius1 + radius2) - dist;

    if (depth <= 0.0) {
        contacts[index] = Contact(false, 0.0, idA, idB, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const Vector3D normal = (dist > 1e-6) ? divide(delta, dist) : Vector3D(1.0, 0.0, 0.0);

    const Point3D  witnessA = subtract(center1, multiply(normal, radius1));
    const Point3D  witnessB = subtract(center2, multiply(normal, radius2));

    contacts[index] = Contact(true, depth, idA, idB, toVec(normal), toVec(witnessA), toVec(witnessB));

}