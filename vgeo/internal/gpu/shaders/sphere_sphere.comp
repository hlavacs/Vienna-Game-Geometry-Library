#version 450

struct Point3D {
    float x;
    float y;
    float z;
};

struct FlatPoint3D {
    float x;
    float y;
    float z;
    float w;
};

struct Vector3D {
    float x;
    float y;
    float z;
};

struct Bivector3D {
    float x;
    float y;
    float z;
};

struct Plane3D {
    float x;
    float y;
    float z;
    float w;
};

struct Circle3D {
    Plane3D g;
    Vector3D v;
    Bivector3D m;
};

struct Sphere3D {
    float u;
    float x;
    float y;
    float z;
    float w;
};

struct Sphere3D_pair {
    Sphere3D sphereA;
    Sphere3D sphereB;
};

struct Contact{
    bool hasContact;
    float depth;
    vec3 normal;
    vec3 witnessA;
    vec3 witnessB;
};

Sphere3D unitize(const Sphere3D sphere){
    float n = -1.0/ sphere.u;
    return Sphere3D(-1.0, sphere.x *n, sphere.y *n, sphere.z *n, sphere.w *n);
}

Circle3D antiwedge(const Sphere3D s, const Sphere3D t){
    const Plane3D g = Plane3D(s.u * t.x - s.x * t.u, 
                        s.u * t.y - s.y * t.u,
                        s.u * t.z - s.z * t.u,
                        s.u * t.w - s.w * t.u);
                        
    const Vector3D v = Vector3D(s.z * t.y - s.y * t.z,
                          s.x * t.z - s.z * t.x,
                          s.y * t.x - s.x * t.y);

    const Bivector3D m = Bivector3D(s.x * t.w - s.w * t.x,
                              s.y * t.w - s.w * t.y,
                              s.z * t.w - s.w * t.z);

    return Circle3D(g, v, m);
}

float squaredRadiusNorm(const Circle3D c){
    return (c.v.x * c.v.x + c.v.y * c.v.y + c.v.z * c.v.z + (c.g.x * c.m.x + c.g.y * c.m.y + c.g.z * c.m.z) * 2.0 - c.g.w * c.g.w);
}

float squaredRadiusNorm(const Sphere3D s){
    return (s.x * s.x + s.y * s.y + s.z * s.z - s.w * s.u * 2.0);
}

FlatPoint3D flatCenter(const Sphere3D s) {
    return FlatPoint3D(s.x, s.y, s.z, -s.u);
}

float magnitude(const Vector3D v) {
    return sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
}

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(set = 0, binding = 0) readonly buffer inBuffer{
    Sphere3D sphere_in[];
};

layout(set = 0, binding = 1) buffer outBuffer{
    Contact contacts[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= pc.N) return;

    //const Sphere3D_pair pair = pairs_in[index];

    const Sphere3D sphereA = sphere_in[2*index];
    const Sphere3D sphereB = sphere_in[2*index+1];

    const Sphere3D s1 = unitize(sphereA);
    const Sphere3D s2 = unitize(sphereB);

    const Circle3D intersectionCircle = antiwedge(s1, s2);

    if (squaredRadiusNorm(intersectionCircle) < 0.0) {
        contacts[index] = Contact(false, 0.0, vec3(0.0, 0.0, 0.0),vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const FlatPoint3D fp1 = flatCenter(s1);
    const FlatPoint3D fp2 = flatCenter(s2);
    const Point3D center1 = Point3D(fp1.x, fp1.y, fp1.z);
    const Point3D center2 = Point3D(fp2.x, fp2.y, fp2.z);
    const float radius1 = sqrt(squaredRadiusNorm(s1));
    const float radius2 = sqrt(squaredRadiusNorm(s2));

    const Vector3D delta = {center1.x - center2.x, center1.y - center2.y, center1.z - center2.z};
    float dist  = magnitude(delta);
    float depth = (radius1 + radius2) - dist;

    if (depth <= 0.0) {
        contacts[index] = Contact(false, 0.0, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const Vector3D normal = (dist > 1e-6) ? Vector3D(delta.x / dist, delta.y / dist, delta.z / dist) : Vector3D(1.0, 0.0, 0.0);

    const Point3D  witnessA = {center1.x - normal.x * radius1, center1.y - normal.y * radius1, center1.z - normal.z * radius1};
    const Point3D  witnessB = {center2.x - normal.x * radius2, center2.y - normal.y * radius2, center2.z - normal.z * radius2};

    //uint hasContact = ((squaredRadiusNorm(intersectionCircle) < 0.0) || (depth <= 0.0)) ? 0 : 1;

    contacts[index] = Contact(true, depth, vec3(normal.x, normal.y, normal.z), vec3(witnessA.x, witnessA.y, witnessA.z), vec3(witnessB.x, witnessB.y, witnessB.z));

}