#version 450

#extension GL_ARB_shading_language_include : enable

#include "shader_terathon.h"
#include "vgeo.h"

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer inBuffer{
    Capsule capsules_in[];
};

layout(std430, set = 0, binding = 1) writeonly buffer outBuffer{
    Capsule capsules_out[];
};

layout(std430, set = 1, binding = 0) readonly buffer dataBuffer{
    TransformData transformData[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {

    uint invocationIndex = gl_GlobalInvocationID.x;

    if (invocationIndex >= pc.N) return;

    uint capsuleIndex = transformData[invocationIndex].index;
    Motor3D motor = transformData[invocationIndex].motor;
    float scale = transformData[invocationIndex].scale;

    Capsule capsule = capsules_in[capsuleIndex];

    capsule = applyTransform(capsule, motor, scale);

    capsules_out[capsuleIndex] = capsule;
}