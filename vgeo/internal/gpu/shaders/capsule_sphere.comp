#version 450

#extension GL_ARB_shading_language_include : enable

#include "shader_terathon.h"
#include "vgeo.h"

struct GpuCapsuleSpherePair{
    vec2 idCapsule;
    Capsule capsule;
    vec2 idSphere;
    Sphere3D sphere;
};

layout(push_constant) uniform PushConstants {
    uint N;
} pc;

layout(std430, set = 0, binding = 0) readonly buffer capsuleBuffer{
    Capsule capsules_in[];
};

layout(std430, set = 0, binding = 1) readonly buffer sphereBuffer{
    Sphere3D spheres_in[];
};

layout(std430, set = 1, binding = 0) readonly buffer inBuffer{
    CollisionPairData pairData_in[];
};

layout(std430, set = 1, binding = 1) writeonly buffer outBuffer{
    Contact contacts[];
};

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

void main() {

    uint index = gl_GlobalInvocationID.x;
    
    if (index >= pc.N) return;
    
    const uint typeA = pairData_in[index].typeA;
    const uint typeB = pairData_in[index].typeB;

    const uint indexA = pairData_in[index].indexA;
    const uint indexB = pairData_in[index].indexB;

    const vec2 id1 = pairData_in[index].instanceHandleA;
    const vec2 id2 = pairData_in[index].instanceHandleB;

    const Motor3D motorA = pairData_in[index].motorA;
    const Motor3D motorB = pairData_in[index].motorB;

    Capsule capsule;
    Sphere3D sphere;

    if(typeA == 1 && typeB == 3){
        capsule = capsules_in[indexA];
        capsule = applyTransform(capsule, motorA, 1.0);

        sphere = spheres_in[indexB];
        sphere = applyTransform(sphere, motorB, 1.0);
    }
    else if(typeA == 3 && typeB == 1){
        capsule = capsules_in[indexB];    
        capsule = applyTransform(capsule, motorB, 1.0);

        sphere = spheres_in[indexA];
        sphere = applyTransform(sphere, motorA, 1.0);
    }
    else{
        contacts[index] = Contact(false, 0.0, id1, id2, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }
    
    const Sphere3D s = unitize(sphere);
    const FlatPoint3D flatCenter = flatCenter(s);
    const Point3D center = {flatCenter.x, flatCenter.y, flatCenter.z};
    const float radiusSphere = sqrt(squaredRadiusNorm(s));

    const Point3D b1 = capsule.a;
    const Point3D b2 = capsule.b;
    const Vector3D d = subtract(b2, b1);
    const float lenSq = squaredMag(d);

    const float t = clamp(dot(subtract(center, b1), d) / lenSq, 0.0, 1.0);
    const Point3D closest = add(b1, multiply(d, t));

    const Vector3D delta  = subtract(closest, center);
    const float distSq = squaredMag(delta);
    const float rSum = radiusSphere + capsule.radius;

    if (distSq >= rSum * rSum) {
        contacts[index] = Contact(false, 0.0, id1, id2, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const float dist  = sqrt(distSq);
    const float depth = rSum - dist;

    if (depth <= 0.0) {
        contacts[index] = Contact(false, 0.0, id1, id2, vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 0.0));
        return;
    }

    const Vector3D normal   = (dist > 1e-6) ? divide(delta, dist) : Vector3D(0.0, 1.0, 0.0);
    const Point3D witnessA = subtract(closest, multiply(normal, capsule.radius));
    const Point3D witnessB = subtract(center, multiply(normal, radiusSphere));

    contacts[index] = Contact(true, depth, id1, id2, toVec(normal), toVec(witnessA), toVec(witnessB));

    
}